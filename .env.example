# ── Server address ─────────────────────────────────────────────
# Domain pointing to this server's IP. Caddy obtains HTTPS automatically.
# To test by IP over plain HTTP, use DOMAIN=:80 and PUBLIC_URL=http://<ip>
DOMAIN=mypay.duckdns.org
PUBLIC_URL=https://mypay.duckdns.org

# ── Secrets ────────────────────────────────────────────────────
# Letters and digits only, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Free project id from https://dashboard.reown.com (enables QR codes and mobile wallets).
# Leave empty to support only browser-extension wallets.
REOWN_PROJECT_ID=

# ── Payments ───────────────────────────────────────────────────
APP_NAME=CryptoPay
# Networks, the first is the default: 84532 Base Sepolia, 11155111 Sepolia, 80002 Polygon Amoy
# Mainnets (real money!): 8453 Base, 1 Ethereum, 137 Polygon
CHAINS=84532,11155111
# Set to false after you have created your shop
ALLOW_REGISTRATION=true
INVOICE_TTL_MINUTES=30

# Optional: private RPC endpoints (Alchemy, Infura…) — more reliable than public ones
# RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/<key>
# RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/<key>
# Optional: confirmations to wait for, per network
# CONFIRMATIONS_84532=5

# ── Tuning ─────────────────────────────────────────────────────
WORKER_INTERVAL_MS=5000
SCAN_BLOCK_RANGE=500
LOG_LEVEL=info
